# GEMINI_API_KEY: Optional Gemini API key (unused by public SG FINANCE website).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical base URL for SEO sitemap.xml, robots.txt, and Open Graph links.
APP_URL="https://sgfinance.example.com"

# Public contact & analytics overrides (can also be managed centrally from Admin Dashboard -> Website Settings).
VITE_WHATSAPP_NUMBER=""
VITE_CONTACT_PHONE=""
VITE_CONTACT_EMAIL=""
VITE_GOOGLE_ANALYTICS_ID=""
VITE_GOOGLE_SITE_VERIFICATION=""

# ------------------------------------------------------------------------------
# SERVER-SIDE ONLY: Automated Customer Enquiry Email Notifications (Resend)
# Never prefix these with VITE_ or expose them to frontend code.
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
NOTIFICATION_EMAIL="in.sg.infra@gmail.com"
# FROM_EMAIL must use a sending domain verified in your Resend account
# (e.g., "SG FINANCE <enquiries@yourdomain.com>").
FROM_EMAIL=""
# Optional: 32+ character secret for signing short-lived enquiry notification tokens.
NOTIFY_SIGNING_SECRET=""

# ------------------------------------------------------------------------------
# OPTIONAL / FUTURE-READY: Official Meta WhatsApp Business Cloud API
# Remains strictly dormant unless WHATSAPP_CLOUD_ENABLED="true" and all
# Meta Business Cloud API credentials below are configured.
# ------------------------------------------------------------------------------
WHATSAPP_CLOUD_ENABLED="false"
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_RECIPIENT_NUMBER=""
WHATSAPP_CLOUD_TEMPLATE_NAME=""
WHATSAPP_CLOUD_TEMPLATE_LANG="en"
WHATSAPP_CLOUD_API_VERSION="v21.0"

